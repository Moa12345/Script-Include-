	var majorIncidentsUtils = Class.create();
	majorIncidentsUtils.prototype = Object.extendsObject(AbstractAjaxProcessor, {
	    updateMajorIncidents: function() {
	        var gr = new GlideRecord('incident');
	        var majorIds = this.getParameter('sysparam_majorids');
	        var loggedUser = this.getParameter('sysparam_loggeduser');
	        gr.addQuery('sys_id', 'IN', majorIds);
	        gr.query();
	        var count = 0;
	        while (gr.next()) {
	            gr.assigned_to = loggedUser;
	            gr.update();
	            count++;
	        }
	        return count;
	    },
	    type: 'majorIncidentsUtils'
	});

