function assignedToMe() {
    var checked = g_list.getChecked();
    if (checked == '') {
        alert("Please Select at least one Record ");
        return false;
    } else {
        
        var ga = new GlideAjax('majorIncidentsUtils');
        ga.addParam('sysparm_name', 'updateMajorIncidents');
        ga.addParam('sysparam_majorids', checked);
        ga.addParam('sysparam_loggeduser', g_user.userID);
        ga.getXMLAnswer(function(answer) {
            alert(answer + ' incidents assigned to you.');
            g_list.refresh();
        });
    }
}
